# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Optional — local development works without it: the Vite dev server proxies
# /api to http://localhost:5000 and the built app defaults to the same URL.
VITE_API_URL=http://localhost:5000

# Legacy Firebase web config (push notifications) — currently unused. If you
# re-enable push notifications, these are PUBLIC-by-design values for Firebase
# web apps; real security lives in Firebase rules, not in this file.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_VAPID_KEY=
